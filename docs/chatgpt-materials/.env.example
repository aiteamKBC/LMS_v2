# Configuration reference only. Do not fill secrets into this tracked file.
# Actual credentials and full British English instructions are in
# backend/.env.chatgpt-materials.private. See HANDOFF_EN_GB.md for placement rules.
# The current Django backend accepts Database_url; production environment wins.
Database_url=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DATABASE?sslmode=require
AZURE_STORAGE_ACCOUNT=REPLACE_STORAGE_ACCOUNT
AZURE_STORAGE_KEY=REPLACE_STORAGE_KEY
AZURE_CURRICULUM_CONTAINER=curriculum-uploads
# Optional for external SDK tools; current curriculum helper uses account + key.
AZURE_STORAGE_CONNECTION_STRING=REPLACE_IF_REQUIRED_BY_THE_APPROVED_UPLOAD_TOOL
# Proposed handoff variable, not a new backend setting or endpoint.
LMS_BASE_URL=https://REPLACE_WITH_DEPLOYED_LMS_ORIGIN
# Proposed placement controls. The manager must select real destination IDs.
TARGET_SELECTION_STATUS=unselected
TARGET_MODE=module_week
TARGET_MODULE_ACTION=use_existing
TARGET_PROGRAMME_ID=UNSELECTED
TARGET_PROGRAMME_NAME=UNSELECTED
TARGET_MODULE_CATALOGUE_ID=UNSELECTED
TARGET_MODULE_TITLE=UNSELECTED
TARGET_COHORT_ID=UNSELECTED_OR_NOT_APPLICABLE
TARGET_GROUP_ID=UNSELECTED_OR_NOT_APPLICABLE
TARGET_WEEK_ACTION=create_new
TARGET_WEEK_ID=UNSELECTED
TARGET_WEEK_NUMBER=UNSELECTED
TARGET_WEEK_TEMPLATE_ID=NOT_APPLICABLE_UNLESS_TEMPLATE_MODE
TARGET_LEARNER_ASSIGNMENT_STATUS=not_verified
PACKAGE_ID=UNALLOCATED
# Use separate placement manifests for multiple modules; do not put comma-separated
# IDs into a database module_catalogue_id or week_id column.
