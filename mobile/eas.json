{
  "cli": {
    "requireCommit": true,
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "ios-testflight": {
      "distribution": "store",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  }
}
