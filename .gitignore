# ===========================================================================
# KBC LearningOS — repository ignore rules
# Monorepo: Django backend (Python) + Vite/React frontend (Node/TypeScript)
# ===========================================================================

# ---------------------------------------------------------------------------
# Python / Django (backend)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
sdist/
wheels/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt
.python-version
__pypackages__/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Django runtime
*.log
*.pid
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
/backend/staticfiles/
/backend/media/
/backend/logs/
local_settings.py
celerybeat-schedule
celerybeat.pid

# Compiled translations (regenerated by compilemessages)
*.mo

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.nox/

# ---------------------------------------------------------------------------
# Node / Vite / React (frontend)
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp.*
.yarn/cache/
.yarn/install-state.gz

# Build output (Vite outDir is "out"; "dist"/"build" covered by the Python
# section's unanchored rules above)
/frontend/out/
dist-ssr/
.vite/

# Auto-generated typings (regenerated by unplugin-auto-import on build)
/frontend/auto-imports.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Test / coverage output
coverage/
playwright-report/
blob-report/
test-results/
.playwright/

# Bundler & tooling caches / artefacts
.turbo/
.swc/
.rollup.cache/
.parcel-cache/
vite.config.ts.timestamp-*
vitest.config.ts.timestamp-*
stats.html

# Logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.eslintcache

# Local overrides (Vite convention)
*.local

# ---------------------------------------------------------------------------
# Secrets & environment files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.direnv/

# Keys, certificates, service credentials — never commit these
*.pem
*.key
*.crt
*.cer
*.csr
*.der
*.p12
*.pfx
*.keystore
*.jks
secrets.json
service-account*.json
google-credentials*.json
azure-credentials*.json

# SSH keys and credential-store files (no extension, so *.key above misses them)
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
!*.pub
.netrc
_netrc
.pgpass
pgpass.conf

# Registry auth tokens, if a local one is ever created
.npmrc
.yarnrc

# ---------------------------------------------------------------------------
# Database dumps & backups
# ---------------------------------------------------------------------------
*.dump
*.sql.gz
*.bacpac

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
.fleet/
.zed/
.history/
nbproject/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# AI / agent tooling (local configuration & scratch state)
# ---------------------------------------------------------------------------
/CLAUDE.md
CLAUDE.local.md
/.claude/
.cursor/
.codex/
.continue/
.windsurf/
.gemini/
.aider*
/.codex-local-ui-test

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ---------------------------------------------------------------------------
# Temporary & backup files
# ---------------------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.temp
*.old

# Archives dropped at the repo root
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz

# ---------------------------------------------------------------------------
# Local-only project files
# ---------------------------------------------------------------------------
# Working notes & session reports (local only, not for the repo)
/SESSION_MEMORY.md
/progress.md
/ENROLMENT_AUDIT.md
/ENROLMENT_FIXES_VERIFICATION.md
/ENROLMENT_GAP_ANALYSIS.md
/ENROLMENT_ISSUES.md
/EVIDENCE_CLOUD.md
/FINAL_IMPLEMENTATION_REPORT.md
/IMPLEMENTATION_VERDICT.md

# Programme documents (PDFs) at repo root
/*.pdf

# Stray root lockfile — the real one lives in /frontend
/package-lock.json

# Manual QA / browser-driving scratch harness
/.qa-tmp/

# Ad-hoc UI verification screenshots & recordings.
# Anchored to the frontend root so /frontend/public assets stay tracked.
/frontend/*.png
/frontend/*.jpg
/frontend/*.jpeg
/frontend/*.gif
/frontend/*.webp
/frontend/*.webm
/frontend/*.mp4
/screenshots/
/frontend/screenshots/

# One-off backfill / migration completion markers
/backend/*_DONE.txt

# Ad-hoc SQL scratch (real schema changes belong in migrations)
/backend/engagement_api/sql/
/backend/curriculum_api/sql/

# Runtime upload target — learner/staff content, never committed
/backend/curriculum_component_uploads/

# Local dev launcher
/backend/run.ps1

# ---------------------------------------------------------------------------
# Security-testing infrastructure & planning docs — LOCAL ONLY (not shipped)
# ---------------------------------------------------------------------------
# The Neon test-branch workflow (sanitise/seed SQL + the branch runserver
# wrapper) and the Playwright baseline / V1–V7 verification suite are kept out
# of the repo by decision: they are tied to the private `security_test` branch
# and its seeded ids, and the planning/audit notes are working documents. The
# product-code fixes and the backend exploit test suite still ship as normal.
/backend/scripts/runserver_test_branch.sh
/backend/scripts/sanitise_test_branch.sql
/backend/scripts/seed_test_branch.sql
/backend/scripts/seed_verify_branch.sql
/frontend/e2e/
/frontend/playwright.config.ts
/frontend/.gitignore

# Planning / audit working documents (kept local)
/SECURITY_AUDIT.md
/M2_PLAN.md
/HANDOVER_M2_TO_NEXT.md
