# ===========================================================================
# KBC LearningOS — repository ignore rules
# Monorepo: Django backend (Python) + Vite/React frontend (Node/TypeScript)
# ===========================================================================

# ---------------------------------------------------------------------------
# Python / Django (backend)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
sdist/
wheels/
.installed.cfg

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Django runtime
*.log
db.sqlite3
db.sqlite3-journal
*.sqlite3
/backend/staticfiles/
/backend/media/
local_settings.py

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Node / Vite / React (frontend)
# ---------------------------------------------------------------------------
node_modules/

# Build output (Vite outDir is "out"; "dist" kept for safety)
/frontend/out/
/frontend/dist/
.vite/

# Auto-generated typings (regenerated by unplugin-auto-import on build)
/frontend/auto-imports.d.ts
/frontend/node_modules
# TypeScript incremental build info
*.tsbuildinfo

# Logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.eslintcache

# ---------------------------------------------------------------------------
# Secrets & environment files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local-only project files
# ---------------------------------------------------------------------------
/backend/engagement_api/sql/
/backend/curriculum_api/sql/
/backend/curriculum_component_uploads/
/backend/quiz_packages/
/backend/run.ps1
/CLAUDE.md
/.claude/
/frontend/src/pages/curriculum/week-builder/quizLinkPersistence.test.tsx
/frontend/src/pages/curriculum/week-builder/WeekComponentRail.test.tsx
/frontend/src/pages/curriculum/week-builder/weekTemplateData.test.ts