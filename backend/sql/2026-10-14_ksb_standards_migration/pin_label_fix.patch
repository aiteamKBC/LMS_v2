diff --git b/backend/learner_api/test_ksb_snapshot_label_no_db.py b/backend/learner_api/test_ksb_snapshot_label_no_db.py
new file mode 100644
index 0000000..f41a130
--- /dev/null
+++ b/backend/learner_api/test_ksb_snapshot_label_no_db.py
@@ -0,0 +1,36 @@
+"""Pin-label fix: a learner KSB version is labelled with the source its items came from."""
+from unittest import mock
+
+from django.test import SimpleTestCase
+
+from learner_api import active_users
+
+ME_ITEMS = [{"code": "K1.1", "description": "Manual point", "type": "Knowledge"}]
+STANDARD_ITEMS = [{"code": "K1", "description": "Standard text", "type": "Knowledge"}]
+
+
+class SnapshotLabelTests(SimpleTestCase):
+    def refresh(self, *, standard_items, name_items):
+        source = mock.Mock(programme="Marketing Executive Level 4")
+        with mock.patch.object(active_users, "_resolve_programme_id", return_value="PROG-ME-L4"), \
+             mock.patch.object(active_users, "_resolve_ksb_profile_source_id", return_value="standard:st0845-v1-1"), \
+             mock.patch.object(active_users, "_fetch_ksb_items_from_profile_source", return_value=standard_items), \
+             mock.patch.object(active_users, "_fetch_ksb_items_for_programme", return_value=name_items), \
+             mock.patch.object(active_users, "_fetch_ksb_items_from_plan_mappings", return_value=[]), \
+             mock.patch.object(active_users, "replace_learner_ksbs") as replace:
+            items = active_users.refresh_learner_ksb_snapshot(mock.Mock(), source, training_plan=object())
+        return items, replace
+
+    def test_fallback_items_never_carry_the_unrelated_standard_label(self):
+        items, replace = self.refresh(standard_items=[], name_items=ME_ITEMS)
+        self.assertEqual(items, ME_ITEMS)
+        self.assertEqual(replace.call_args.kwargs["source_profile_id"], "PROG-ME-L4")
+
+    def test_items_read_from_the_standard_keep_its_label(self):
+        items, replace = self.refresh(standard_items=STANDARD_ITEMS, name_items=ME_ITEMS)
+        self.assertEqual(items, STANDARD_ITEMS)
+        self.assertEqual(replace.call_args.kwargs["source_profile_id"], "standard:st0845-v1-1")
+
+    def test_fetch_ksb_items_still_returns_only_items(self):
+        with mock.patch.object(active_users, "_fetch_ksb_items_with_source", return_value=(ME_ITEMS, "")):
+            self.assertEqual(active_users._fetch_ksb_items("x"), ME_ITEMS)
