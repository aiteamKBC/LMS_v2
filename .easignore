# EAS archives this monorepo from its Git root. Include only the mobile app.
/*
!/mobile/

# This file replaces .gitignore for the EAS archive: repeat local exclusions.
**/node_modules/
**/.git/
**/.expo/
**/.private/
**/.env*
**/credentials.json
**/google-services.json
**/GoogleService-Info.plist
**/*.keystore
**/*.jks
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.mobileprovision
**/*.ipa
**/*.apk
**/*.aab
**/*.xcarchive/
**/*.dSYM/
**/*.log
**/service-account*.json
**/google-credentials*.json
**/azure-credentials*.json
**/secrets.json
**/.npmrc
**/.netrc
**/.pgpass
**/id_rsa*
**/id_ed25519*
**/*.pfx
**/*.cer
**/*.crt
**/*.csr
**/*.der
**/id_dsa*
**/id_ecdsa*
**/_netrc
**/pgpass.conf
**/.yarnrc
**/.direnv/
**/.aws/
**/.ssh/
**/.codex/
**/*.local
**/*.sqlite3*
**/*.db
**/*.dump
**/*.bacpac
**/*.sql
**/*.sql.gz
**/*.bak
**/.cache/
**/.npm/
**/.yarn/
**/.pnpm-store/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/
**/.playwright/
**/*.tsbuildinfo
**/.DS_Store
**/Thumbs.db
/mobile/dist/
/mobile/dist-native/
/mobile/dist-ios/
/mobile/artifacts/
# Keep the maintained Android source. Generate iOS from reviewed Expo config.
/mobile/ios/
/mobile/android/.gradle/
/mobile/android/.kotlin/
/mobile/android/.cxx/
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/app/.cxx/
/mobile/android/local.properties
